# ==============================================================================
# ADDMAI Environment Configuration Template (Stage 1.1 Hardened)
# ==============================================================================
# SECURITY NOTICE:
# 1. Never commit active credentials, production passwords, or API keys to Git.
# 2. Values marked 'DEVELOPMENT ONLY' are strictly for local docker-compose / testing.
# 3. Production deployments MUST supply explicit, unique, cryptographically strong
#    passwords and secret keys. The application will refuse to start in production
#    if default development credentials are used.
# 4. Duplicate this template to '.env' for local development:
#    cp .env.example .env

# --- Application Identity & Runtime ---
APP_NAME="ADDMAI API"
APP_ENV=development
APP_VERSION=0.1.0
LOG_LEVEL=INFO

# --- Service Ports (Host bindings) ---
API_PORT=8000
FRONTEND_PORT=5173
POSTGRES_PORT=5432
REDIS_PORT=6379
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# --- PostgreSQL Relational Database ---
# [DEVELOPMENT ONLY DEFAULT]: In production, set a strong, unique password.
POSTGRES_USER=addmai
POSTGRES_PASSWORD=addmai_dev_password
POSTGRES_DB=addmai
DATABASE_URL=postgresql+asyncpg://addmai:addmai_dev_password@localhost:5432/addmai

# --- Redis Task Broker & State Cache ---
REDIS_URL=redis://localhost:6379/0

# --- MinIO / S3-Compatible Object Storage ---
# [DEVELOPMENT ONLY DEFAULT]: In production, provide production S3/MinIO credentials.
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=addmai-uploads
MINIO_CONSOLE_URL=http://localhost:9001

# --- CORS Configuration ---
# Explicit origins only. Wildcard '*' is strictly prohibited for security compliance.
CORS_ALLOWED_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# --- Frontend Client Configuration ---
VITE_API_BASE_URL=http://localhost:8000
